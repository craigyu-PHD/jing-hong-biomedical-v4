{
  "name": "anubis-erp",
  "private": true,
  "version": "0.1.0",
  "description": "精鴻動物生醫 ANUBIS ERP monorepo｜合規防呆設計／風險提醒：全數合成資料，PROTOTYPE_NOT_APPROVED，非已部署系統",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:unit": "node --test packages/domain/dist-test/**/*.test.js 2>/dev/null || pnpm --filter @anubis/domain test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @anubis/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2"
  }
}
